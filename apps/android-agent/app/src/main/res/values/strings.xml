    <string name="app_name">Sovereign Android Runtime</string>
    <string name="accessibility_service_label">Sovereign UI Adapter</string>
    <string name="accessibility_service_description">Allows Sovereign to observe a bounded accessibility tree and perform revision-bound actions that you authorize. It does not enable Root or unrestricted shell access.</string>
    <string name="notification_listener_label">Sovereign Notification Adapter</string>
    <string name="notification_listener_description">Allows Sovereign to report bounded active-notification status and locally redacted current content. It does not read history or dispatch notification actions in this build.</string>
