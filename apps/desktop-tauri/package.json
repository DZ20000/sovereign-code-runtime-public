{
  "name": "@sovereign/desktop-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebView2 desktop shell for Sovereign Code Runtime.",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:rust": "pnpm prepare:runtime && cargo test --manifest-path src-tauri/Cargo.toml --lib --quiet && node scripts/test-health-monitor-recovery.mjs",
    "prepare:runtime": "pnpm --dir ../.. run build:runtime && pnpm --filter @sovereign/desktop run build:native && pnpm --filter @sovereign/runtime-host run bundle && node scripts/prepare-runtime.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:debug": "tauri build --debug --no-bundle",
    "build": "tauri build --no-bundle",
    "make": "node scripts/build-installer.mjs",
    "package:portable": "pnpm build && node scripts/package-portable.mjs",
    "verify:portable": "node scripts/verify-portable-package.mjs",
    "start:portable": "node scripts/start-portable.mjs",
    "restart": "node scripts/restart-portable.mjs",
    "restart:dry-run": "node scripts/restart-portable.mjs --dry-run",
    "restart:portable": "node scripts/restart-portable.mjs --latest-portable",
    "restart:portable:dry-run": "node scripts/restart-portable.mjs --latest-portable --dry-run",
    "install:restart-shortcut": "node scripts/install-restart-shortcut.mjs",
    "install:watchdog-task": "node scripts/install-watchdog-task.mjs",
    "install:watchdog-task:dry-run": "node scripts/install-watchdog-task.mjs --dry-run",
    "remove:watchdog-task": "node scripts/install-watchdog-task.mjs --remove",
    "smoke:restart-launcher": "node scripts/restart-portable.mjs --latest-portable --dry-run",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "smoke:update-preflight": "pnpm --filter @sovereign/update-core build && node scripts/smoke-update-preflight.mjs",
    "package:renderer-update": "pnpm build:web && pnpm --filter @sovereign/update-core build && node scripts/package-renderer-update.mjs",
    "smoke:renderer-update": "pnpm --filter @sovereign/update-core build && node scripts/smoke-renderer-update-package.mjs",
    "prepare:renderer-trust": "pnpm --filter @sovereign/update-core build && node scripts/prepare-renderer-trust.mjs --allow-disabled",
    "prepare:renderer-trust:release": "pnpm --filter @sovereign/update-core build && node scripts/prepare-renderer-trust.mjs --require-enabled",
    "smoke:renderer-trust": "pnpm --filter @sovereign/update-core build && node scripts/smoke-renderer-trust.mjs",
    "smoke:approval": "node scripts/smoke-approval.mjs",
    "smoke:guardian": "node scripts/smoke-host-guardian.mjs",
    "smoke:guardian:packaged": "node scripts/smoke-packaged-host-guardian.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "package:installer": "node scripts/build-installer.mjs",
    "install:nsis": "node scripts/install-nsis-and-restart.mjs",
    "install:nsis:dry-run": "node scripts/install-nsis-and-restart.mjs --dry-run",
    "verify:installed": "node scripts/verify-installed-nsis.mjs --require-running",
    "audit:installed-ui": "node scripts/installed-ui-audit.mjs",
    "smoke:installer-install:dry-run": "node scripts/smoke-installer-install.mjs --dry-run --passes 2",
    "smoke:installer-install": "node scripts/smoke-installer-install.mjs --apply --passes 2",
    "smoke:installer-cutover": "node scripts/install-nsis-and-restart.mjs --dry-run && node scripts/smoke-restart-control.mjs",
    "package:installer:dry-run": "node scripts/build-installer.mjs --dry-run",
    "smoke:restart-control": "node scripts/smoke-restart-control.mjs",
    "smoke:restart-control:debug": "node scripts/smoke-restart-control.mjs --debug",
    "runtime:candidate:create": "node scripts/create-runtime-candidate.mjs",
    "runtime:index:stage": "node scripts/stage-runtime-host-release-index.mjs",
    "runtime:index:audit": "node scripts/audit-runtime-host-release-index.mjs",
    "runtime:candidate:audit": "node scripts/audit-runtime-candidate-state.mjs",
    "runtime:update:preflight": "node scripts/runtime-update-preflight.mjs"
  },
  "dependencies": {
    "@sovereign/control-plane-contract": "workspace:*",
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@sovereign/update-core": "workspace:*",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.10",
    "typescript": "^5.9.2",
    "vite": "^8.1.0"
  },
  "license": "Apache-2.0"
}
