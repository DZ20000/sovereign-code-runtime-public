# Reference only. The gateway reads process environment variables directly.
SCR_HOST=127.0.0.1
SCR_PORT=3210
# Leave blank here. Generate a fresh process-environment secret using docs/development.md.
# The former replace-with-* placeholder is deliberately rejected.
SCR_BEARER_TOKEN=
SCR_WORKSPACE_ROOT=C:\Projects\sovereign-code-runtime
SCR_AUDIT_DB=C:\Projects\sovereign-code-runtime\.scr\audit.sqlite
SCR_PRINCIPAL_ID=local-owner
SCR_CAPABILITIES=system.read,workspace.read,files.read,files.write,search.read,git.read,validation.run
SCR_ALLOWED_HOSTS=127.0.0.1:3210,localhost:3210,[::1]:3210
SCR_ALLOWED_ORIGINS=http://127.0.0.1:3210,http://localhost:3210,http://[::1]:3210
