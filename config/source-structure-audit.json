{
  "schemaVersion": "scr.source-structure-audit-config/v1",
  "recommendedMaxLines": 700,
  "hardMaxLines": 1200,
  "maximumSourceBytes": 8388608,
  "sourceExtensions": [
    ".cjs",
    ".cs",
    ".css",
    ".cts",
    ".java",
    ".js",
    ".jsx",
    ".kt",
    ".kts",
    ".mjs",
    ".mts",
    ".ps1",
    ".psm1",
    ".py",
    ".rs",
    ".scss",
    ".sh",
    ".sql",
    ".ts",
    ".tsx"
  ],
  "excludedDirectoryNames": [
    ".cache",
    ".dart_tool",
    ".git",
    ".gradle",
    ".turbo",
    ".vite",
    ".worktrees",
    "artifacts",
    "autogenerated",
    "build",
    "coverage",
    "dist",
    "gen",
    "node_modules",
    "out",
    "target",
    "visual-artifacts"
  ],
  "baselinePath": "config/source-structure-baseline.json"
}
